# Copy this file to .env and fill in values for your LLM provider.

LLM_API_KEY=your_api_key_here

# Leave empty to use OpenAI's default API base URL.
# For OpenAI-compatible local or hosted providers, set a full base URL.
LLM_BASE_URL=

LLM_MODEL=gpt-4o-mini

# Google Sheets CRM sync settings
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEETS_CREDENTIALS_FILE=/absolute/path/to/service-account.json
