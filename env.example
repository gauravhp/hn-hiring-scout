# OpenAI-compatible LLM settings
#
# Copy this file to .env and fill in the provider you want to use.
# analyze_jobs.py requires LLM_API_KEY and LLM_MODEL unless --dry-run is used.
# Leave LLM_BASE_URL empty to use OpenAI's default API base URL.

# For Fireworks:
LLM_API_KEY=your_fireworks_api_key
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# For OpenAI:
# LLM_API_KEY=your_openai_api_key
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# Google Sheets CRM sync settings
#
# Create a Google Cloud service account, download its JSON credentials,
# share your target Google Sheet with the service account email, then set:
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEETS_CREDENTIALS_FILE=/absolute/path/to/service-account.json
